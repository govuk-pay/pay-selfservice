{% extends "simplified-account/settings/settings-layout.njk" %}

{% set settingsPageTitle = details.name %}

{% block settingsContent %}
  <h1 class="govuk-heading-l page-title"> New API key </h1>

  {{
    govukInsetText({
      html: "Copy your API key and store it securely.<br><br>You will not be able to see it again after you leave this page."
    })
  }}

  <p class="govuk-body">
    You must copy the whole key, including the <span class="key-prefix">api_test_</span> or
    <span class="key-prefix">api_live_</span> prefix.
  </p>

  {{
    govukWarningText(
      {
        text: 'Keep your API key secure',
        iconFallbackText: 'Warning'
      }
    )
  }}

  <ul class="govuk-list govuk-list--bullet">
    <li>You must not include your API key in emails, support tickets or other messages to GOV.UK Pay.</li>
    <li>You must not put your API key in publicly accessible documents or repositories.</li>
    <li>Share your API key only with people or organisations that need it.</li>
  </ul>

  <p class="govuk-body">
    <a class="govuk-link" href="https://docs.payments.service.gov.uk/security/#securing-your-developer-keys">
      Read more about securing your API keys</a
    >.
  </p>

  <h2 class="govuk-heading-m"> {{ details.name }} </h2>
  <div>
    <span id="api-key" class="code copy-this-api-key govuk-!-margin-top-6">{{ details.key }}</span>
  </div>

  {{
    govukButton({
      text: "Copy API key to clipboard",
      classes: "govuk-button--secondary govuk-!-margin-top-6",
      attributes: {
        id: "copy-key-button",
        "data-copy-text": true,
        "data-target": "copy-this-api-key",
        "data-success": "API key has been copied",
        "data-notification-target": "copy-this-api-key-notification"
      }
    })
  }}

  <div class="copy-this-api-key-notification govuk-visually-hidden" aria-live="assertive"></div>
{% endblock %}
