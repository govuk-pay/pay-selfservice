{% extends "simplified-account/settings/settings-layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% set settingsPageTitle = 'Does your organisation have a company registration number?' %}
{% set companiesHouseLink = 'https://find-and-update.company-information.service.gov.uk/' %}

{% block settingsContent %}


{% set companyRegistrationNumberHint %}
<p>You can find the registration number on the
  <a class="govuk-link" href="{{ companiesHouseLink }}" target="_blank" rel="noopener noreferrer">Companies House
    register (opens in new tab)</a>, your certificate of incorporation or official letters from Companies House.
</p>
{% endset %}

<h1 class="govuk-heading-l">{{ settingsPageTitle }}</h1>
<form id="has-company-registration-number-form" autocomplete="off" method="post" class="govuk-!-margin-top-3">
  <input id="csrf" name="csrfToken" type="hidden" value="{{ csrf }}" />
  {{
      govukRadios({
        idPrefix: "has-company-registration-number",
        name: "hasCompanyRegistrationNumber",
                hint: {
          html: companyRegistrationNumberHint
        },
        errorMessage: { text: errors.formErrors['hasCompanyRegistrationNumber'] } if errors.formErrors['hasCompanyRegistrationNumber'] else false,
        items: [
          {
            value: "true",
            text: "Yes",
            checked: hasCompanyRegistrationNumber === "true",
            attributes: {
              "data-cy": "radio-yes"
            }
          },
          {
            value: "false",
            text: "No",
            checked: hasCompanyRegistrationNumber === "false",
            attributes: {
              "data-cy": "radio-no"
            }
          }
        ]
      })
    }}

  {{
      govukButton({
        id: "has-company-registration-number-submit",
        text: "Continue",
        preventDoubleClick: true
      })
    }}
</form>
{% endblock %}